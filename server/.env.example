# Copy this file to ".env" (same folder) if you want to change settings.
# Stage 0 works fine WITHOUT a .env file: everything has a safe default.

# Port the API listens on.
# If you change it, also change the proxy target in client/vite.config.ts.
PORT=4000

# Not needed until Stage 2 (login). Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# then remove the "#" below and paste the result after the equals sign.
# NEVER commit .env or share this value.
# SESSION_SECRET=
